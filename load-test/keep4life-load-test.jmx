        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/category/all" enabled="true">
            <stringProp name="HTTPSampler.path">/api/category/all</stringProp>
